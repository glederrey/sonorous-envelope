# Copy to .env.local (apps/web/.env.local) and fill in. Never commit .env.local.
# Same names go in Vercel: Project Settings -> Environment Variables.
# Source of truth: docs/implementation/stack-and-layout.md

# --- Supabase (Dashboard -> Project Settings -> API / API Keys) ---

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (anon) key. Public, safe in the browser. RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role / secret key. SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
# Used only for the few tasks listed in docs/implementation/database.md.
SUPABASE_SERVICE_ROLE_KEY=

# Auth issuer: <NEXT_PUBLIC_SUPABASE_URL>/auth/v1
SUPABASE_AUTH_ISSUER=

# JWKS endpoint used to verify OAuth access tokens.
# Expected: <NEXT_PUBLIC_SUPABASE_URL>/auth/v1/.well-known/jwks.json (verify against the project)
SUPABASE_JWKS_URL=

# --- App (Vercel) ---

# Public origin of the deployed app, no trailing slash.
# Local: http://localhost:3000   Prod: https://<your-app>.vercel.app
PUBLIC_BASE_URL=

# MCP endpoint. Must equal ${PUBLIC_BASE_URL}/api/mcp
MCP_RESOURCE_URL=
